# Copia este archivo como ".env" y completa los valores. NO subas el .env al repositorio.

# Endpoint del modelo en Microsoft Foundry (el mismo valor que usaron en los notebooks del curso)
FOUNDRY_MODEL_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/openai/v1/

# Nombre EXACTO del deployment del modelo en Foundry
FOUNDRY_MODEL_DEPLOYMENT=<nombre-del-deployment>

# (Opcional) Versión del modelo. Los notebooks del curso la leen, aunque este laboratorio no la usa.
FOUNDRY_MODEL_VERSION=

# La autenticación usa Microsoft Entra ID (DefaultAzureCredential):
# inicia sesión antes con "az login". No se guardan API keys en este proyecto.
